{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "statement_type": {
            "enum": [
              "source_statement",
              "application"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "issue_ids",
          "evidence_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "abstain": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "units",
    "limitations",
    "abstain"
  ]
}
