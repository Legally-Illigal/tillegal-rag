{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "draft_version": {
      "type": "integer",
      "minimum": 1
    },
    "claim_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true
          },
          "action": {
            "enum": [
              "keep",
              "revise",
              "remove",
              "needs_evidence"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "claim_id",
          "citation_ids",
          "action",
          "reason"
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "draft_version",
    "claim_reports"
  ]
}
